<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>world.consistent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/consistent-world</string>
    <string>--config</string>
    <string>/usr/local/etc/consistent-world/consistent_world.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/consistent_world.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/consistent_world.err</string>
  <key>WorkingDirectory</key>
  <string>/tmp</string>
</dict>
</plist>
