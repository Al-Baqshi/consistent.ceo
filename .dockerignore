# Keep the build context small and, more importantly, keep host artifacts out of
# the image. `COPY sveltfront ./` in the ui stage would otherwise drop the host's
# node_modules (macOS-native esbuild/rollup binaries) on top of the ones npm ci
# just installed inside the linux container, and the SPA build would fail.
node_modules/
**/node_modules/

# Rust build output — never needed in the context, and gigabytes of it.
target/
**/target/

# Regenerated by crates/gateway/build.rs from sveltfront/build; a stale host copy
# must not shadow the freshly built SPA.
crates/gateway/dashboard_build/

# Not part of the gateway image.
.git/
.github/
desktop/
mobile/
ios/
docs/
*.dmg
.DS_Store
