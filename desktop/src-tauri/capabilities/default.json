{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/consistent-world",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/consistent-dictate",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/consistent-whisper",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
