<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Embedded into the binary as a __TEXT,__info_plist section by build.rs.
	     A flat CLI that touches the microphone is SIGABRT'd by TCC without a
	     usage-description string; this provides it. Whisper runs fully
	     on-device, so only the microphone is needed (no speech-recognition API). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Consistent transcribes your speech on-device to type where your cursor is.</string>
</dict>
</plist>
